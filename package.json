{
  "name": "template-tanstack-start",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "vite dev --port ${PORT:-3000}",
    "setup": "bun run scripts/setup.ts",
    "start": "bun run server.ts",
    "build": "tsr generate && ./node_modules/typescript-7/bin/tsc --noEmit && vite build && bun run build:extension",
    "build:node": "tsr generate && ./node_modules/typescript-7/bin/tsc --noEmit && FOR_SITES=true vite build && bun run build:extension",
    "build:extension": "bun run scripts/build-extension.ts",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "typecheck": "./node_modules/typescript-7/bin/tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "generate:routes": "tsr generate",
    "generate:feed": "bun run scripts/generate-feed/index.ts",
    "check:secrets": "bun run scripts/check-no-secrets.ts",
    "clean": "rm -rf .output dist node_modules/.vite .nitro .tanstack"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/archiver": "^8.0.0",
    "@typesafe-ai/sdk": "0.7.0",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.11.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.2",
    "@tanstack/router-cli": "^1.167.45",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "17.13.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "^5.0.5"
  }
}
